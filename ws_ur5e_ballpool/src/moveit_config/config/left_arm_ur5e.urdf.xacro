<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="left_arm_ur5e">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import left_arm_ur5e urdf file -->
    <xacro:include filename="$(find left_arm_description)/urdf/left_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="left_arm_ur5e.ros2_control.xacro" />


    <xacro:left_arm_ur5e_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
