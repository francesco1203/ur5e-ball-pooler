<mujoco model="left_arm_ur5e">
  <compiler angle="radian" meshdir="assets/" texturedir="assets/"/>

  <option integrator="implicitfast" timestep="0.002"/>


  <default>

    <!-- PEZZI DEL ROBOT -->
    <default class="ur5e">
      <!-- PARAMETRI DI DEFAULT  -->


      <!-- parametri materiali -->
      <material specular="0.20" shininess="1.0"/>

      <!-- parametri giunti (asse z di rotazione, range e inerzia del motore (armature))-->
      <joint axis="0 0 1" range="-6.28319 6.28319" armature="0.1"/>

      <!-- parametri attuatori (tipo di guadagno e bias, range di forza) -->
      <!-- per info leggi guida https://mujoco.readthedocs.io/en/stable/XMLreference.html#actuator-general -->

      <!-- I giunti possono essere di tipo "size3" o "size1"  -->
      <!-- per info consulta https://www.universal-robots.com/articles/ur/robot-care-maintenance/max-joint-torques-cb3-and-e-series/-->
      
      <!-- Definiamo le regole per gli attuatori di posizione per i giunti grandi -->
      <default class="size3">
        <position ctrlrange="-6.28319 6.28319" kp="2000" kv="400" forcerange="-150 150"/>
      </default>

      <!-- Definiamo le regole per gli attuatori di posizione per i polsi -->
      <default class="size1">
        <position ctrlrange="-6.28319 6.28319" kp="500" kv="100" forcerange="-28 28"/>
      </default>


      <!-- parametri di default per la visualizzazione-->
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      
      <!-- GESTIONE DELLE COLLISIONI -->
      <!-- Deciamo di attivare le collisioni solo tra end-effector e oggetti di interesse (es. pallina da biliardo) e disattivarle per il resto del robot (es. braccio, polsi, ecc.) -->
      <!-- per maggiori informazioni su come funziona la bitmask contype e conaffinity, consulta https://mujoco.readthedocs.io/en/stable/XMLreference.html -->

      <!-- parametri di default per la collisione-->
      <default class="joint_collision">
        <geom type="mesh" group="3" contype="0" conaffinity="0"/>
      </default>

      <default class="structure_collision">
        <geom type="mesh" group="3" contype="0" conaffinity="0"/>
      </default>

       <default class="end_effector_collision">
         <!-- definito come sotto, interagisce solo con la ballina bianca  -->
        <geom type="mesh" group="3" contype="8" conaffinity="2"/> 
      </default>


      <!-- punti d'interesse per la visualizzazione-->
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="5"/>

    </default>



    <!-- BILIARDO -->
       
    <!-- parametri di default per la visualizzazione-->
    <default class="visual_environment">
        <geom type="mesh" group="1" contype="0" conaffinity="0"/>
    </default>

    <!-- GESTIONE DELLE COLLISIONI -->
    <!-- Attive solo le collisioni tra oggetti di interesse (biliardo con palline, palline con biliardo ed end-effector)-->
    <!-- per maggiori informazioni su come funziona la bitmask contype e conaffinity, consulta https://mujoco.readthedocs.io/en/stable/XMLreference.html -->

    <!-- BILIARDO (contype=1): collide con Bianca (2) e Colorate (4) -> conaffinity = 2 + 4 = 6 -->
    <default class="biliardo_collision">
        <geom group="3" contype="1" conaffinity="6"
              friction="0.1 0.0 0.0"
              solref="0.002 1.0" solimp="0.99 0.999 0.001"/>
    </default>


    <!-- !!! NOTA: PARAMETRI FRICTION DA TARARE CON ESPERIMENTI REALI -->


    <!-- PALLINA BIANCA (contype=2): collide con Biliardo (1), Bianca (2), Colorate (4) ed EE (8) -> conaffinity = 15 -->
    <default class="pallina_bianca_collision">
        <geom type="sphere" size="0.0125" mass="0.010"
              contype="2" conaffinity="15"
              friction="0.1 0.0 0.0"
              solref="0.002 1.0" solimp="0.99 0.999 0.001"    
              group="3"/>
    </default>

    <!-- PALLINE COLORATE (contype=4): collidono con Biliardo (1), Bianca (2) e Colorate (4) -> conaffinity = 7 -->
    <!-- NOTA: Ignorano completamente l'End-Effector -->
    <default class="pallina_colorata_collision">
        <geom type="sphere" size="0.0125" mass="0.015"
              contype="4" conaffinity="7"
              friction="0.1 0.0 0.0"
              solref="0.002 1.0" solimp="0.99 0.999 0.001"
              group="3"/>
    </default>
    

  </default>

  
