    </asset>

    <worldbody>
        <!-- TAVOLO DA BILIARDO -->
        <body name="tavolo_biliardo" pos="0.8 0 0">
            
            <!-- grafica: visuale pura -->
            <geom class="visual_environment" type="mesh" mesh="campo_biliardo" material="verde_biliardo"/>
            <geom class="visual_environment" type="mesh" mesh="sponde_biliardo" material="legno"/>

            <!-- geometria di collisione -->

