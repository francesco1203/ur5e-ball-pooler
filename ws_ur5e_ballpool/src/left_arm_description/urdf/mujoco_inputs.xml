<?xml version="1.0"?>
<!--
  File di input MuJoCo-specifico per left_arm_ur5e.
  Va passato al tool di conversione con l'opzione -m (mujoco_inputs).

  NOTE:
  1) I nomi dei giunti (shoulder_pan, shoulder_lift, elbow, wrist_1/2/3) assumono
     il prefisso di default left_ impostato da tf_prefix_left nello xacro.
     Se nel file left_arm_ur5e.ros2_control.xacro i nomi sono diversi, vanno
     allineati qui uno a uno: il nome joint di ogni elemento position deve
     combaciare esattamente con il nome del giunto nel ros2_control.xacro.
  2) I valori di kp sono un punto di partenza ragionevole per una UR5e, non
     valori definitivi: se il movimento risulta troppo morbido o oscillante
     andranno ritarati dopo i primi test in sim.
  3) Il mesh_name in decompose_mesh deve corrispondere al nome che il file MJCF
     generato assegna alla mesh dell'holder: controlla dentro l'MJCF prodotto
     (di solito deriva dal nome del file obj, holder_with_cut_rod) e correggi
     se il tool l'ha rinominata diversamente.
-->
<mujoco_inputs>

  <raw_inputs>
    <actuator>
      <position name="left_shoulder_pan_joint"  joint="left_shoulder_pan_joint"  kp="2000"/>
      <position name="left_shoulder_lift_joint" joint="left_shoulder_lift_joint" kp="2000"/>
      <position name="left_elbow_joint"         joint="left_elbow_joint"         kp="1500"/>
      <position name="left_wrist_1_joint"       joint="left_wrist_1_joint"       kp="500"/>
      <position name="left_wrist_2_joint"       joint="left_wrist_2_joint"       kp="500"/>
      <position name="left_wrist_3_joint"       joint="left_wrist_3_joint"       kp="500"/>
    </actuator>
  </raw_inputs>

  <processed_inputs>
    <!-- Decompone separatamente le mesh dell'holder e della cut_rod in piu'
         parti convesse (V-HACD), per garantire contatti fisici e collisioni
         accurati nell'ambiente MuJoCo -->
    <decompose_mesh mesh_name="holder" threshold="0.02"/>
    <decompose_mesh mesh_name="cut_rod" threshold="0.02"/>
  </processed_inputs>

</mujoco_inputs>
