<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>real_camera</name>
  <version>0.0.0</version>
  <description>
    Naive camera: read balls position from a file and communicate to others
  </description>
  <maintainer email="francesco.schettini12@gmail.com">francesco</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Dipendenze ROS 2 base -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>

  <!-- NUOVE DIPENDENZE PER I QUATERNIONI E LA ROTAZIONE DEGLI ASSI -->
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- Dipendenza tua libreria di headers -->
  <depend>shared_headers_pkg</depend>

  <!-- Dipendenza per yaml-cpp (decommentata perché fake_camera legge il file YAML) -->
  <!-- <depend>yaml-cpp</depend> -->

  <!-- Dipendenze esterne di sistema -->
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>